{
  "name": "@ai-crm/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsc -b --watch --preserveWatchOutput",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.build.json --force && node -e \"require('node:fs').copyFileSync('worker-healthcheck.mjs','dist/worker-healthcheck.mjs')\"",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false",
    "test": "pnpm exec turbo run build --filter=@ai-crm/worker && vitest run --config ../../vitest.config.ts --testTimeout=30000",
    "contracts:check": "node ../../scripts/check/verify-package.mjs"
  },
  "dependencies": {
    "@ai-crm/config": "workspace:*",
    "@ai-crm/database": "workspace:*",
    "@ai-crm/observability": "workspace:*",
    "@ai-crm/crm-eventing-outbox": "workspace:*",
    "@ai-crm/crm-file-center": "workspace:*",
    "@ai-crm/crm-notifications": "workspace:*",
    "@ai-crm/crm-task-center": "workspace:*",
    "@ai-crm/crm-workforce-access": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "amqplib": "2.0.1",
    "cos-nodejs-sdk-v5": "2.15.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
