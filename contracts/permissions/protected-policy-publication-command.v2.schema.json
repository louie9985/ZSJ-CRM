{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-crm.local/permissions/v2/protected-policy-publication-command.schema.json",
  "title": "Protected Authorization Policy Publication Command V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "publicationId", "publishedAt", "operationId", "auditOperationIds", "traceId", "actor", "reason", "snapshot"],
  "properties": {
    "contractVersion": { "const": "authorization-policy.v2" },
    "publicationId": { "$ref": "#/$defs/uuid" },
    "publishedAt": { "$ref": "#/$defs/timestamp" },
    "expectedPreviousVersion": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/policyVersion" }] },
    "operationId": { "$ref": "#/$defs/uuid" },
    "auditOperationIds": {
      "type": "object", "additionalProperties": false,
      "required": ["authorizationDenied", "authorizationFailed", "publicationFailed"],
      "properties": {
        "authorizationDenied": { "$ref": "#/$defs/uuid" },
        "authorizationFailed": { "$ref": "#/$defs/uuid" },
        "publicationFailed": { "$ref": "#/$defs/uuid" }
      }
    },
    "traceId": { "type": "string", "pattern": "^(?!00000000000000000000000000000000)[0-9a-f]{32}$" },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["actorId", "actorType", "subject"],
      "properties": {
        "actorId": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,254}$" },
        "actorType": { "const": "authenticated_subject" },
        "subject": {
          "type": "object", "additionalProperties": false, "required": ["workforcePersonId", "activeAssignmentIds"],
          "properties": {
            "workforcePersonId": { "$ref": "#/$defs/uuid" },
            "activeAssignmentIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
            "selectedAssignmentId": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    },
    "reason": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]{0,63}$" } }
    },
    "snapshot": { "$ref": "https://contracts.ai-crm.local/permissions/v2/authorization-policy.schema.json" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "timestamp": { "type": "string", "maxLength": 24, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  }
}
