{
  "attributes": [
    {
      "name": "username",
      "displayName": "用户名",
      "validations": {
        "length": { "min": 4, "max": 32 },
        "pattern": { "pattern": "^[A-Za-z0-9._-]+$", "error-message": "用户名格式不正确" }
      },
      "permissions": { "view": ["admin", "user"], "edit": ["admin"] },
      "multivalued": false
    },
    {
      "name": "email",
      "displayName": "邮箱",
      "validations": {
        "email": {},
        "length": { "max": 255 }
      },
      "permissions": { "view": ["admin"], "edit": ["admin"] },
      "multivalued": false
    },
    {
      "name": "phone_login_key",
      "displayName": "手机号登录键",
      "validations": {
        "pattern": { "pattern": "^\\+?[0-9]{6,20}$", "error-message": "手机号格式不正确" }
      },
      "permissions": { "view": ["admin"], "edit": ["admin"] },
      "multivalued": false
    },
    {
      "name": "ai_crm_account_id",
      "displayName": "AI CRM Account ID",
      "validations": { "length": { "max": 64 } },
      "permissions": { "view": ["admin"], "edit": ["admin"] },
      "multivalued": false
    },
    {
      "name": "ai_crm_credential_operation_id",
      "displayName": "Credential Operation ID",
      "validations": { "length": { "max": 36 } },
      "permissions": { "view": ["admin"], "edit": ["admin"] },
      "multivalued": false
    },
    {
      "name": "ai_crm_credential_expires_at",
      "displayName": "Credential Operation Expiry",
      "validations": { "length": { "max": 32 } },
      "permissions": { "view": ["admin"], "edit": ["admin"] },
      "multivalued": false
    },
    {
      "name": "ai_crm_credential_operator_subject",
      "displayName": "Credential Operator Subject",
      "validations": { "length": { "max": 128 } },
      "permissions": { "view": ["admin"], "edit": ["admin"] },
      "multivalued": false
    },
    {
      "name": "ai_crm_credential_secret_hash",
      "displayName": "Credential Secret Digest",
      "validations": { "length": { "max": 64 } },
      "permissions": { "view": ["admin"], "edit": ["admin"] },
      "multivalued": false
    },
    {
      "name": "ai_crm_credential_return_uri",
      "displayName": "Credential Return URI",
      "validations": { "length": { "max": 1024 } },
      "permissions": { "view": ["admin"], "edit": ["admin"] },
      "multivalued": false
    },
    {
      "name": "ai_crm_credential_completed_operation_id",
      "displayName": "Completed Credential Operation ID",
      "validations": { "length": { "max": 36 } },
      "permissions": { "view": ["admin"], "edit": ["admin"] },
      "multivalued": false
    },
    {
      "name": "ai_crm_credential_completed_operator_subject",
      "displayName": "Completed Credential Operator Subject",
      "validations": { "length": { "max": 128 } },
      "permissions": { "view": ["admin"], "edit": ["admin"] },
      "multivalued": false
    }
  ],
  "groups": []
}
