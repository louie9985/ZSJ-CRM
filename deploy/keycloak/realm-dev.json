{
  "realm": "ai-crm-dev",
  "enabled": true,
  "displayName": "ZSJ CRM",
  "displayNameHtml": "ZSJ CRM",
  "loginTheme": "zsj-crm",
  "internationalizationEnabled": true,
  "supportedLocales": ["zh-CN"],
  "defaultLocale": "zh-CN",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "editUsernameAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 900,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 900,
  "passwordPolicy": "length(8) and regexPattern(^[\\x20-\\x7E]{8,64}$)",
  "browserFlow": "browser-with-phone",
  "authenticationFlows": [
    {
      "alias": "browser-with-phone",
      "description": "ZSJ CRM browser authentication",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "browser-with-phone-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-with-phone-forms",
      "description": "Username or managed phone login",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "ai-crm-username-or-phone",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "ai-crm-pc-bff",
      "name": "AI-CRM PC BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__AI_CRM_PC_CLIENT_SECRET__",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://127.0.0.1:8088/auth/pc/login"
      },
      "redirectUris": ["http://127.0.0.1:8088/auth/pc/callback"],
      "webOrigins": ["http://127.0.0.1:8088"],
      "protocolMappers": [
        {
          "name": "ai-crm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ai-crm-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ai-crm-workforce-provisioner",
      "name": "AI-CRM Workforce Provisioner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__AI_CRM_WORKFORCE_ADMIN_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "ai-crm-workforce-sync-worker",
      "name": "AI-CRM Workforce Sync Worker",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__AI_CRM_WORKFORCE_WORKER_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-ai-crm-workforce-provisioner",
      "enabled": true,
      "serviceAccountClientId": "ai-crm-workforce-provisioner",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    },
    {
      "username": "service-account-ai-crm-workforce-sync-worker",
      "enabled": true,
      "serviceAccountClientId": "ai-crm-workforce-sync-worker",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ],
  "roles": { "realm": [] }
}
