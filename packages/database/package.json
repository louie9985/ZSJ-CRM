{
  "name": "@ai-crm/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "prisma:generate": "node ../../scripts/prisma/generate.mjs --config ../../prisma.config.ts",
    "build": "pnpm prisma:generate && tsc -b",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false",
    "test": "vitest run --config ../../vitest.config.ts",
    "contracts:check": "node ../../scripts/check/verify-package.mjs",
    "migrate": "node ../../scripts/migration/run.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.16.3"
  }
}
