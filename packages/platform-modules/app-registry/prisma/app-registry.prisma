// Module-owned Prisma source fragment. Database CHECK constraints and the
// composite self/route foreign keys remain governed by migration 0000000006.
model AppRegistryApplication {
  applicationId String  @id @map("application_id") @db.VarChar(128)
  audience      String  @db.VarChar(16)
  enabled       Boolean
  permissionCode String @map("permission_code") @db.VarChar(129)

  @@map("applications")
  @@schema("app_registry")
}

model AppRegistryRoute {
  routeId         String   @id @map("route_id") @db.VarChar(128)
  applicationId   String   @map("application_id") @db.VarChar(128)
  path            String   @db.VarChar(256)
  enabled         Boolean
  permissionCode  String   @map("permission_code") @db.VarChar(129)
  deepLinkSources String[] @map("deep_link_sources")

  @@unique([applicationId, routeId], map: "routes_application_route_unique")
  @@index([applicationId], map: "routes_application_idx")
  @@map("routes")
  @@schema("app_registry")
}

model AppRegistryNavigation {
  navigationId       String  @id @map("navigation_id") @db.VarChar(128)
  applicationId      String  @map("application_id") @db.VarChar(128)
  routeId            String  @map("route_id") @db.VarChar(128)
  parentNavigationId String? @map("parent_navigation_id") @db.VarChar(128)
  enabled            Boolean
  displayOrder       Int     @map("display_order")

  @@unique([applicationId, navigationId], map: "navigation_application_id_unique")
  @@index([applicationId, displayOrder], map: "navigation_application_order_idx")
  @@map("navigation")
  @@schema("app_registry")
}

model AppRegistryOperationReceipt {
  operationId String   @id @map("operation_id") @db.Uuid
  fingerprint String   @db.VarChar(64)
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@map("operation_receipts")
  @@schema("app_registry")
}
