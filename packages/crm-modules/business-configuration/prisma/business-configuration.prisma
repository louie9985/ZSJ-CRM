// Immutability triggers, CHECK constraints and database foreign keys remain
// governed by migration 0000000008.
model BusinessConfigurationDictionaryDraft {
  dictionaryId String   @id @map("dictionary_id") @db.VarChar(128)
  ownerModule  String   @map("owner_module") @db.VarChar(128)
  revision     Int
  items        Json
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(6)
  @@map("dictionary_drafts")
  @@schema("business_configuration")
}

model BusinessConfigurationDictionaryRelease {
  dictionaryId  String   @map("dictionary_id") @db.VarChar(128)
  releaseVersion Int     @map("release_version")
  ownerModule   String   @map("owner_module") @db.VarChar(128)
  contentDigest String   @map("content_digest") @db.VarChar(64)
  items         Json
  publishedAt   DateTime @map("published_at") @db.Timestamptz(6)
  @@id([dictionaryId, releaseVersion])
  @@map("dictionary_releases")
  @@schema("business_configuration")
}

model BusinessConfigurationParameterDefinition {
  parameterKey String @id @map("parameter_key") @db.VarChar(128)
  definition   Json
  @@map("parameter_definitions")
  @@schema("business_configuration")
}

model BusinessConfigurationParameterValue {
  parameterKey  String   @map("parameter_key") @db.VarChar(128)
  valueVersion  Int      @map("value_version")
  contentDigest String   @map("content_digest") @db.VarChar(64)
  value         Json
  publishedAt   DateTime @map("published_at") @db.Timestamptz(6)
  @@id([parameterKey, valueVersion])
  @@map("parameter_values")
  @@schema("business_configuration")
}

model BusinessConfigurationParameterActivation {
  activationId  String    @id @map("activation_id") @db.Uuid
  parameterKey  String    @map("parameter_key") @db.VarChar(128)
  valueVersion  Int       @map("value_version")
  scopeType     String    @map("scope_type") @db.VarChar(128)
  scopeReference String   @map("scope_reference") @db.VarChar(255)
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  @@unique([activationId, parameterKey], map: "configuration_activation_parameter_unique")
  @@index([parameterKey, scopeType, scopeReference, effectiveFrom, effectiveTo], map: "configuration_activation_resolution_idx")
  @@map("parameter_activations")
  @@schema("business_configuration")
}

model BusinessConfigurationActivationTermination {
  terminationId String   @id @map("termination_id") @db.Uuid
  activationId  String   @unique(map: "parameter_activation_terminations_activation_id_key") @map("activation_id") @db.Uuid
  parameterKey  String   @map("parameter_key") @db.VarChar(128)
  effectiveTo   DateTime @map("effective_to") @db.Timestamptz(6)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  @@map("parameter_activation_terminations")
  @@schema("business_configuration")
}

model BusinessConfigurationOperationReceipt {
  operationId String @id @map("operation_id") @db.Uuid
  fingerprint String @db.VarChar(64)
  result      Json
  @@map("operation_receipts")
  @@schema("business_configuration")
}

model BusinessConfigurationOutboxEvent {
  eventId         String    @id @map("event_id") @db.Uuid
  eventType       String    @map("event_type") @db.VarChar(80)
  resourceId      String    @map("resource_id") @db.VarChar(128)
  resourceVersion Int       @map("resource_version")
  occurredAt      DateTime  @map("occurred_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  lastError       String?   @map("last_error")
  @@map("outbox_events")
  @@schema("business_configuration")
}
