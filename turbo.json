{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["AI_CRM_AUTHORIZATION_REDIS_PASSWORD_FILE"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "contracts:check": {
      "dependsOn": ["^contracts:check"]
    }
  }
}
